{
  "rules": {
    "groepen": {
      ".read": true,
      ".write": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$id": {
        ".validate": "newData.hasChildren(['naam', 'aantal'])",
        "naam":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "aantal": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "t":      { ".validate": "newData.isNumber()" },
        "foto":   { ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 400000" },
        "$other": { ".validate": false }
      }
    },
    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    }
  }
}
